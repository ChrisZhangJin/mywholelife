# Template for /app/dream.env — copy, fill in real values, chmod 0600.
# NEVER commit the real dream.env (see .gitignore). Cron does not inherit the
# container environment, so this file is sourced explicitly by the crontab
# line in mywholelife.cron.

export MWL_DATA_ROOT=/data
export MWL_DB_PATH=/data/mywholelife.db
export MWL_AGENT_ID=00000000-0000-0000-0000-000000000000

export LLM_BASE_URL=https://api.deepseek.com/v1
export LLM_API_KEY=
# verify against the live model catalog before deploy (api-docs.deepseek.com) —
# deepseek-chat alias retired 2026-07-24; deepseek-v4-flash is the current
# replacement (thinking disabled for latency/cost). The dream job degrades to
# a deterministic brief-derived hook if this id is wrong or unreachable (D-02).
export DREAM_MODEL=deepseek-v4-flash

export T1=14
export T2=90
export T3=180
export GRACE=30
export DREAM_MAX_DELETIONS=50
